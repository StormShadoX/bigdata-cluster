services:
  namenode:
    image: bde2020/hadoop-namenode:2.0.0-hadoop3.2.1-java8
    container_name: namenode
    hostname: namenode
    restart: unless-stopped
    ports:
      - "9870:9870"
      - "9000:9000"
    environment:
      CLUSTER_NAME: iset-cluster
      CORE_CONF_fs_defaultFS: hdfs://namenode:9000
      HDFS_CONF_dfs_replication: "3"
    volumes:
      - ./hadoop/data/namenode:/hadoop/dfs/name
    networks: [bigdata-net]

  datanode1:
    image: bde2020/hadoop-datanode:2.0.0-hadoop3.2.1-java8
    container_name: datanode1
    hostname: datanode1
    restart: unless-stopped
    environment:
      CORE_CONF_fs_defaultFS: hdfs://namenode:9000
      SERVICE_PRECONDITION: namenode:9870
    volumes:
      - ./hadoop/data/datanode1:/hadoop/dfs/data
    depends_on: [namenode]
    networks: [bigdata-net]

  datanode2:
    image: bde2020/hadoop-datanode:2.0.0-hadoop3.2.1-java8
    container_name: datanode2
    hostname: datanode2
    restart: unless-stopped
    environment:
      CORE_CONF_fs_defaultFS: hdfs://namenode:9000
      SERVICE_PRECONDITION: namenode:9870
    volumes:
      - ./hadoop/data/datanode2:/hadoop/dfs/data
    depends_on: [namenode]
    networks: [bigdata-net]

  datanode3:
    image: bde2020/hadoop-datanode:2.0.0-hadoop3.2.1-java8
    container_name: datanode3
    hostname: datanode3
    restart: unless-stopped
    environment:
      CORE_CONF_fs_defaultFS: hdfs://namenode:9000
      SERVICE_PRECONDITION: namenode:9870
    volumes:
      - ./hadoop/data/datanode3:/hadoop/dfs/data
    depends_on: [namenode]
    networks: [bigdata-net]

  datanode4:
    image: bde2020/hadoop-datanode:2.0.0-hadoop3.2.1-java8
    container_name: datanode4
    hostname: datanode4
    restart: unless-stopped
    environment:
      CORE_CONF_fs_defaultFS: hdfs://namenode:9000
      SERVICE_PRECONDITION: namenode:9870
    volumes:
      - ./hadoop/data/datanode4:/hadoop/dfs/data
    depends_on: [namenode]
    networks: [bigdata-net]

networks:
  bigdata-net:
    driver: bridge
